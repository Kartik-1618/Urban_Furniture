# ============================================================
# Urban Furniture Accounting System — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/urban_furniture_db

# ── Authentication ───────────────────────────────────────────
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Backend Server ───────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Urban Furniture Accounting System

# ── PostgreSQL (Docker Compose) ──────────────────────────────
POSTGRES_USER=urban_user
POSTGRES_PASSWORD=urban_password
POSTGRES_DB=urban_furniture_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── File Uploads (optional) ──────────────────────────────────
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=./uploads
